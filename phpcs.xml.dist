<?xml version="1.0"?>
<!--
	File: phpcs.xml.dist
	Path: pgp-encryption-for-contact-page/phpcs.xml.dist
	PHPCS ruleset: WordPress Coding Standards 3 + PHPCompatibilityWP (PHP 7.4+).
-->
<ruleset name="PGP Encryption for Contact Page">
	<description>Coding standards for PGP Encryption for Contact Page.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="pgp-encryption-for-contact-page"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="pgp_ecp"/>
				<element value="PGP_ECP"/>
			</property>
		</properties>
	</rule>
</ruleset>
